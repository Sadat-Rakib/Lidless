<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Lidless.App</RootNamespace>
    <AssemblyName>Lidless</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Lidless.ico</ApplicationIcon>
    <StartupObject>Lidless.App.App</StartupObject>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WFAC010 wants WinForms SetHighDpiMode; this app is WPF-first and uses the manifest. -->
    <NoWarn>$(NoWarn);CS1591;WFAC010</NoWarn>
    <Description>Windows tray app: keep your PC awake with the lid closed.</Description>
    <Product>Lidless</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lidless.Core\Lidless.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Lidless.ico" />
  </ItemGroup>
</Project>
